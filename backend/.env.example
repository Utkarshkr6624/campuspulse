APP_NAME=CampusPulse
DATABASE_URL=sqlite:///./campuspulse.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=replace-this-with-a-random-string-at-least-32-characters
JWT_EXPIRE_MINUTES=120

# Document storage
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./storage/uploads
DOCUMENT_MAX_UPLOAD_BYTES=10485760

# CampusPulse AI (never commit real keys)
# Providers: mock | openai_compatible | disabled
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=10
