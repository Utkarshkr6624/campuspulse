APP_NAME=CampusPulse
DATABASE_URL=sqlite:///./campuspulse.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=replace-this-with-a-random-string-at-least-32-characters
JWT_EXPIRE_MINUTES=120

# Document storage
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./storage/uploads
DOCUMENT_MAX_UPLOAD_BYTES=10485760

# CampusPulse assistant uses deterministic, no-network responses by default.
AI_PROVIDER=deterministic
AI_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=10
